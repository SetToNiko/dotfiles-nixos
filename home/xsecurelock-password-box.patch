+  Window unused_root, unused_child;
+  int unused_x, unused_y;
+  unsigned int mask = 0;
+  XQueryPointer(display, parent_window, &unused_root, &unused_child, &unused_x,
+                &unused_y, &unused_x, &unused_y, &mask);
