# home-manager settings that only apply to the desktop.
# Per-host dotfile fragments live in configs/hosts/desktop (linked to ~/.config/host).
{ ... }:

{
  # Dual monitor layout. Loaded at i3 startup by configs/hosts/desktop/i3.conf
  # (`autorandr --load docked`).
  programs.autorandr = {
    enable = true;
    # Re-centre the wallpaper once the monitor layout has changed
    hooks.postswitch.wallpaper = "wallpaper-rotate refresh";
    profiles = {
      docked = {
        fingerprint = {
          DP-2 = "";
          HDMI-1 = "";
        };
        config = {
          DP-2 = {
            enable = true;
            primary = true;
            mode = "2560x1440";
            rate = "165.00";
          };
          HDMI-1 = {
            enable = true;
            mode = "2560x1440";
            rate = "59.95";
            rotate = "left";
            position = "2560x0";
          };
        };
      };
    };
  };
}
